            "five_drone_pairs",
            "analysis_results/wind_strength_stage_ratio_diagnosis_20260909/expanded_stage_pairs.csv",
            "analysis_results/battery_normalization_v3_with_b15_20260909/model.json"
          ],
          "filters": [
            "Wind level > 0",
            "All five matched calibrated drones present with both stages",
            "No prepare/merged/outlier or faulty comparison windows"
          ],
          "metric_definitions": {
            "rank": "1 is fastest SOC percentage decrease per minute; descending rank, no rounding before ranking",
            "same_fastest": "Medium top-ranked physical drone is also top-ranked in the compared stage",
            "near_tie_gap": "100*(fastest rate / second-fastest rate - 1)"
