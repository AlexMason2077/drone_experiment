      "id": "individual_analysis",
      "label": "五个无风Hover的个体分界搜索",
      "path": "/Users/alexmason/Downloads/drone_experiment/analysis_results/bideal_boundary_search_20260908/individual_stages/individual_candidates.csv",
      "query": {
        "engine": "SQLite + Python / NumPy calibration",
        "language": "sql",
        "sql": "SELECT battery, method, upper, lower, run_id, source,\nCOUNT(*) AS samples,\nsqrt(AVG((observed_soc-modeled_soc)*(observed_soc-modeled_soc))) AS rmse_pp\nFROM individual_fit_residuals\nGROUP BY battery, method, upper, lower, run_id, source\nORDER BY battery, method",
        "description": "SQL从全部真实样本与模型残差重新计算图中的RMSE；分界搜索及段长计算入口：output_py/inspect_individual_battery_stages.py，复用search_bideal_boundaries.py。原始CSV及SHA256见sources.json。",
        "filters": [
          "2026-09-06 current five battery/drone pairs",
          "95→20 observed hover",
          "B12 D2 excluded"
        ],
        "metric_definitions": [
          "RMSE over all real samples; per-flight endpoint calibration, not out-of-sample validation."
        ]
      }
