    {
      "id": "diamond-forward-example",
      "title": "Diamond / 50cm / 顶风 Level2：旧前进换算示例",
      "queries": [
        {
          "id": "forward-medium-example",
          "source": {
            "label": "condition_position_medium_means.csv；两组历史250cm前进实验",
            "filters": [
              "只用前进数据",
              "Medium 参考SOC82%→52%"
