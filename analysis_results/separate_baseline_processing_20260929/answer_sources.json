              "old_baseline_rate_pp_min": 7.1880126067,
              "new_position_baseline_rate_pp_min": 9.6425516473,
              "old_to_new_position_scale": 1.3414767301
            },
            {
              "position": 5,
              "old_battery_id": "B12",
