            "caveats": [
              "图表示统一参考阶段的计算曲线，实际250cm段时间没有被拉伸。",
              "旧数据缺少High/Low，因此这张仅画Medium。"
            ],
            "metricDefinitions": [
              {
                "id": "forward-medium-example-metric",
                "definition": "同条件位置的有效实验率等权平均；参考Medium时间=60×30/标准化率。"
