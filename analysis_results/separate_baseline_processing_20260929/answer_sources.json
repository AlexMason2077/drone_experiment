{
  "schemaVersion": 1,
  "items": [
    {
      "id": "separate-results-scope",
      "title": "前进与风洞两个独立结果",
      "queries": [
        {
          "id": "separate-scope",
          "source": {
            "label": "两套独立 manifest；固定九月份参考模型",
            "filters": [
              "无跨协议平均",
              "当前五项危险配置已排除",
              "旧前进包含50/75cm；风洞只含50cm"
            ],
            "caveats": [
              "250cm已有结果只支持Medium；40条没有该阶段前进时间。",
              "风洞21条件包含20个Level1/2条件与一个实际Level3条件。",
              "缺失整段系数与观测率分开；部分观测阶段的全阶段曲线也是计算延伸。",
              "没有更改baseline、原始记录、控制器或训练集。"
            ],
            "metricDefinitions": [
              {
                "id": "separate-scope-metric",
                "definition": "先独立得到对应SOC阶段的率，再从SOC差/率计算参考阶段时间；此处没有两类平均。"
              }
            ]
          },
          "rows": [
            {
              "step": "历史250cm换算",
              "runs": 133,
              "conditions": 54,
              "observed_rates": 625,
              "unobserved_stage_completion": 0
            },
            {
              "step": "50cm风洞独立处理",
              "runs": 21,
              "conditions": 21,
              "observed_rates": 293,
              "unobserved_stage_completion": 22
            }
          ],
          "columns": [
            {
              "field": "step",
              "label": "处理步骤"
            },
            {
              "field": "runs",
              "label": "保留实验数"
            },
            {
              "field": "conditions",
              "label": "条件数"
            },
            {
              "field": "observed_rates",
              "label": "观测率条数"
            },
            {
              "field": "unobserved_stage_completion",
              "label": "缺整段模型系数数"
            }
          ]
        },
        {
          "id": "medium-baseline-ratios",
          "source": {
            "label": "对应旧基线悬停记录与固定九月份模型",
            "filters": [
              "各自电池Medium区间",
              "旧基线使用同逻辑无人机+电池",
              "参考模型保持不变"
            ],
            "caveats": [
              "P5旧B15到当前B12的相对负载转移是一个假设。",
              "不同日期间比例稳定并未由本处理独立证实。"
            ],
            "metricDefinitions": [
              {
                "id": "medium-baseline-ratios-metric",
                "definition": "调整后原始率=旧原始率×新目标基线阶段率/旧基线同阶段率；标准化率=调整率/新目标基线率×固定参考率。"
              }
            ]
          },
          "rows": [
            {
              "position": 1,
              "old_battery_id": "B11",
              "new_position_battery_id": "B11",
              "old_baseline_rate_pp_min": 7.7799202767,
              "new_position_baseline_rate_pp_min": 7.8967311354,
              "old_to_new_position_scale": 1.015014403
            },
            {
